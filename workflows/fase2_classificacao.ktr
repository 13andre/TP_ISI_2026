    <name>points</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>points</field_name>
      <formula_string>IF([goals_scored]&gt;[goals_conceded];3;IF([goals_scored]=[goals_conceded];1;0))</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>0</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>wins</field_name>
      <formula_string>IF([goals_scored]&gt;[goals_conceded];1;0)</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>0</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>draws</field_name>
      <formula_string>IF([goals_scored]=[goals_conceded];1;0)</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>0</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>losses</field_name>
      <formula_string>IF([goals_scored]&lt;[goals_conceded];1;0)</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>0</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>goal_difference</field_name>
      <formula_string>[goals_scored]-[goals_conceded]</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>0</value_precision>
      <replace_field/>
    </formula>
